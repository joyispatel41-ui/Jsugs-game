name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main, master]
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Use Java 17
        run: echo "JAVA_HOME=$JAVA_HOME_17_X64" >> "$GITHUB_ENV"
      - name: Create the Android app
        run: |
          mkdir -p app/www
          cp index.html app/www/index.html
          cd app
          npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6 three@0.128.0
          cp node_modules/three/build/three.min.js www/three.min.js
          node -e "require('fs').writeFileSync('capacitor.config.json', JSON.stringify({appId:'com.sawjaw.game',appName:'Sawjaw 3D',webDir:'www',backgroundColor:'#0f0b0d',server:{androidScheme:'https'}}))"
          npx cap add android
          sed -i '0,/<activity/s//<activity android:screenOrientation="portrait"/' android/app/src/main/AndroidManifest.xml
          npx cap sync android
      - name: Build the APK
        run: |
          cd app/android
          chmod +x gradlew
          ./gradlew assembleDebug
      - name: Keep a copy as a build artifact
        uses: actions/upload-artifact@v4
        with:
          name: sawjaw-apk
          path: app/android/app/build/outputs/apk/debug/app-debug.apk
      - name: Publish the APK as a release
        env:

          GH_TOKEN: ${{ github.token }}
        run: |
          gh release create "build-${{ github.run_number }}" app/android/app/build/outputs/apk/debug/app-debug.apk --title "Sawjaw 3D build ${{ github.run_number }}" --notes "Download app-debug.apk below and install it on your Android phone."
